# Copy this file to `.env` and replace the placeholders with real values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public URL of this API. Used to build links in outgoing emails.
APP_URL="http://localhost:3000"

# Secret used to sign access tokens. Required in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Set to `true` to send email through the Brevo API, or `false` to use SMTP.
EMAIL_USE_BREVO=false

# Sender details used by both providers.
EMAIL_FROM="no-reply@picharo.local"
EMAIL_FROM_NAME="Picharo"

# Brevo API (used when EMAIL_USE_BREVO=true).
BREVO_API_KEY=""

# SMTP (used when EMAIL_USE_BREVO=false).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# Auth tokens
# ---------------------------------------------------------------------------
# How long email validation and password reset links stay valid (in minutes).
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
