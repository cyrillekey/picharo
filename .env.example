# Copy this file to `.env` and replace the placeholders with real values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public URL of this API. Used to build links in outgoing emails.
APP_URL="http://localhost:3000"

# Secret used to sign access tokens. Required in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Set to `true` to send email through the Brevo API, or `false` to use SMTP.
EMAIL_USE_BREVO=false

# Sender details used by both providers.
EMAIL_FROM="no-reply@picharo.local"
EMAIL_FROM_NAME="Picharo"

# Brevo API (used when EMAIL_USE_BREVO=true).
BREVO_API_KEY=""

# SMTP (used when EMAIL_USE_BREVO=false).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# Redis / background jobs
# ---------------------------------------------------------------------------
# BullMQ stores queued events in Redis. Set REDIS_URL, or use the
# individual connection fields below. REDIS_URL takes precedence.
REDIS_URL=""
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TLS=false

# Queue namespace (all BullMQ keys are prefixed with this value).
QUEUE_PREFIX="picharo"
# Number of times a failed event is retried before it is parked.
QUEUE_JOB_ATTEMPTS=3
# Initial retry delay; each retry backs off exponentially.
QUEUE_JOB_BACKOFF_MS=1000
# Number of events the worker processes concurrently.
QUEUE_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Auth tokens
# ---------------------------------------------------------------------------
# How long email validation and password reset links stay valid (in minutes).
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
