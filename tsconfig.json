{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",  
    "sourceMap": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts","prisma.config.ts"],
}
