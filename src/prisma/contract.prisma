// use prisma-8
model User {
  id            String             @id @default(sql`gen_random_uuid()`)
  email         String             @unique
  password      String
  country       String
  bio           String
  emailVerified Boolean            @default(false)
  watchHistory  WatchHistory[]
  watchlist     WatchList[]
  createdat     DateTime           @default(now()) @onCreate(now())
  updatedat     temporal.UpdatedAt

  @@map("users")
}

model Movie {
  id               Int                @id
  title            Text
  description      Text
  popularity       Float
  averagevote      Float
  voteCount        Int?
  ageRating        String?  
  release_date     DateTime?
  mediaType        String
  originalLanguage String
  languages        String[]
  collection       String?
  award            String?
  poster           String?
  externalId       String             @unique
  genres           MovieGenre[]       @relation(name: "moviegenrerelationship",)
  watchHistory     WatchHistory[]
  watchlists       WatchList[]
  createdat        DateTime           @default(now()) @onCreate(now())
  updatedat        temporal.UpdatedAt

  @@map("movie")
}

model WatchHistory {
  id              Int                @default(autoincrement()) @id
  movieId         Int
  startDate       Date               @default(now())
  endDate         Date?
  status          WatchStatus        @default(PARTIAL)
  movie           Movie              @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userId          String
  duration        Int                @default(1)
  watchedDuration Int                @default(1)
  pausecount      Int                @default(0)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdat       DateTime           @default(now()) @onCreate(now())
  updatedat       temporal.UpdatedAt

  // @@unique([movieId, userId])
  @@map("watchhistory")
}

model WatchList {
  id        Int                @id @default(autoincrement())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   Int
  movie     Movie              @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdat DateTime           @default(now()) @onCreate(now())
  updatedat temporal.UpdatedAt

  @@unique([movieId, userId])
  @@map("watchlist")
}

model Genre {
  // Fields
  id        Int                @id
  name      String
  movies    MovieGenre[]       @relation(name: "genremovierelationship")
  createdat DateTime           @default(now()) @onCreate(now())
  updatedat temporal.UpdatedAt

  @@map("genre")
}

model MovieGenre {
  // Fields
  id        Int                @id @default(autoincrement())
  movie     Movie              @relation(name: "moviegenrerelationship", fields: [movieId], references: [id], onDelete: Cascade)
  movieId   Int
  genre     Genre              @relation(name: "genremovierelationship", fields: [genreId], references: [id], onDelete: Cascade)
  genreId   Int
  createdat DateTime           @default(now()) @onCreate(now())
  updatedat temporal.UpdatedAt

  @@unique([movieId, genreId])
  @@map("moviegenre")
}

enum WatchStatus {
  FULL = "full"
  PARTIAL = "partial"
}
