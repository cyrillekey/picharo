{
  "type": "module",
  "name": "picharo",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc && tsc-alias -p tsconfig.json",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@prisma/orm-postgres": "^8.0.0-rc.23",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.4.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.8",
    "@types/nodemailer": "^8.0.2",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^8.0.0-rc.33",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.9.10",
    "typescript": "~5.9.2"
  }
}
