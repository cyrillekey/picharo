{
  "type": "module",
  "name": "picharo",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "start": "npm run build && fastify start -l info dist/src/app.js",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "watch:ts": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/src/app.js",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@prisma/orm-postgres": "^8.0.0-rc.21",
    "@scalar/fastify-api-reference": "^1.76.2",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "stremio-addon-sdk": "https://github.com/Stremio/stremio-addon-sdk.git"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@types/node": "^24.0.8",
    "@types/stremio-addon-sdk": "^1.6.12",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^10.13.0",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^8.0.0-rc.28",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.9.9",
    "typescript": "~5.9.2"
  }
}
